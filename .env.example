# Local tests: enable explicitly and add your own server-side key.
CONTENTSIGNAL_ENABLE_LIVE_API=false
CONTENTSIGNAL_MAX_API_CALLS=10
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Hosted production only: set to the verified protected Vercel project ID.
# Requires Vercel Authentication with All Deployments; never disable protection.
CONTENTSIGNAL_PROTECTED_PROJECT_ID=
